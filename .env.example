# ---- App ----
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32

# ---- Domain Configuration (for subdomain routing) ----
# Change this to your actual domain in production (e.g., website.com)
# For development, leave as is
NEXT_PUBLIC_DOMAIN=powerpaytech.com

# ---- Database (Supabase Postgres connection string) ----
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Use the "Session"/pooler string; include your DB password.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---- Supabase Storage (for proof images) ----
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Email (Resend) ----
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Paycryptt <onboarding@resend.dev>

# ---- VTpass (Bill Payments) ----
VTPASS_API_KEY=your-vtpass-api-key
VTPASS_SECRET_KEY=your-vtpass-secret-key
VTPASS_BASE_URL=https://sandbox.vtpass.com

# ---- Development Tools ----
# Set to true to enable verbose logging
DEBUG=false
